# Solo desarrollo local. No copiar valores ni destinos de producción.
# El overlay dev define PostgreSQL y Redis dentro de la red de Docker.
COMPOSE_PROJECT_NAME=corestream-grupo1-local
DATABASE_URL=postgresql+asyncpg://corestream:corestream@postgres:5432/corestream
REDIS_URL=redis://redis:6379/0
ENVIRONMENT=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:7357,http://127.0.0.1:7357
FORWARDED_ALLOW_IPS=127.0.0.1
UVICORN_WORKERS=1
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
AZURE_TRANSLATOR_KEY=
VITE_API_BASE_URL=/api
